From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Wed, 7 Oct 2026 10:32:18 -0400
Subject: [PATCH] d3d12: Destroy a command allocator's encoders when it is
 released.

The destructor freed the CPU heap without the encoders' destructors that
Reset runs, so an allocator released without a Reset kept what its lists
recorded: an upscale's MetalFX upscaler never went back to the device's
pool (a new one is ~230 MB that macOS never frees), and render and blit
encoders leaked their references too. Both now run the same helper, which
also frees the spilled CPU heaps the destructor left.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d12/d3d12_command_allocator.cpp | 9 ++++++---
 src/d3d12/d3d12_command_allocator.hpp | 6 ++++++
 2 files changed, 12 insertions(+), 3 deletions(-)

diff --git a/src/d3d12/d3d12_command_allocator.cpp b/src/d3d12/d3d12_command_allocator.cpp
index eb6dd17..a605223 100644
--- a/src/d3d12/d3d12_command_allocator.cpp
+++ b/src/d3d12/d3d12_command_allocator.cpp
@@ -117,7 +117,12 @@ MTLD3D12CommandAllocatorImpl::Reset() {
     DXMT_STAT_SCOPE("allocator.Reset");
   if (encoder_last)
     return E_FAIL;
+  DestroyEncoders();
+  return Initialize();
+};
 
+void
+MTLD3D12CommandAllocatorImpl::DestroyEncoders() {
   for (auto &encoder_list : encoder_lists_) {
     EncoderData *next = encoder_list.next;
     while (next) {
@@ -151,9 +156,7 @@ MTLD3D12CommandAllocatorImpl::Reset() {
   for (auto ptr : spilled_cpu_heap_)
     free(ptr);
   spilled_cpu_heap_.clear();
-
-  return Initialize();
-};
+}
 
 MTLD3D12CommandAllocatorImpl::PooledICB &
 MTLD3D12CommandAllocatorImpl::AcquireICB(WMTIndirectCommandBufferInfo &info, size_t MaxCount, WMTResourceOptions storage) {
diff --git a/src/d3d12/d3d12_command_allocator.hpp b/src/d3d12/d3d12_command_allocator.hpp
index eab3987..4069750 100644
--- a/src/d3d12/d3d12_command_allocator.hpp
+++ b/src/d3d12/d3d12_command_allocator.hpp
@@ -126,6 +126,9 @@ public:
   MTLD3D12CommandAllocatorImpl(MTLD3D12Device *pDevice, D3D12_COMMAND_LIST_TYPE Type);
 
   ~MTLD3D12CommandAllocatorImpl() {
+    // MacNeutron: released without a Reset, the encoders still let go of what they hold (an upscale's MetalFX
+    // upscaler goes back to the device's pool), and the spilled heaps go too.
+    DestroyEncoders();
     free(cpu_heap_);
     cpu_heap_ = nullptr;
     gpu_heap_buffer_ = {};
@@ -142,6 +145,9 @@ public:
 
   HRESULT STDMETHODCALLTYPE Reset();
 
+  // The recorded encoders' destructors, and the CPU heaps they spilled into, freed (Reset and the destructor).
+  void DestroyEncoders();
+
   HRESULT STDMETHODCALLTYPE CreateCommandList(
       UINT NodeMask, D3D12_COMMAND_LIST_TYPE Type, ID3D12PipelineState *pInitialPipelineState, REFIID riid,
       void **ppCommandList

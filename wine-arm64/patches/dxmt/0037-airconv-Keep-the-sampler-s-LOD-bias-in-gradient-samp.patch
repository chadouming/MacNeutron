From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Thu, 8 Oct 2026 06:58:33 -0400
Subject: [PATCH] airconv: Keep the sampler's LOD bias in gradient samples.

D3D adds a sampler's MipLODBias to the LOD of every sample, SampleGrad
and sample_d included; Metal's gradient sample takes no bias, and the
DXIL and DXBC lowerings dropped it. Scale both derivatives by 2^bias
instead, which moves the LOD by the bias, also where Metal's anisotropic
filter would hold a biased LOD at log2(major / maxAnisotropy) (D3DMetal
gives LOD 2 there for an 8:1 footprint at 4x with bias -1; D3D gives 1).
A zero bias scales by 1. Translated shaders change, so the translator's
cache key does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/airconv/dxil/dxil_lower_resources.cpp | 5 +++++
 src/airconv/nt/dxbc_converter_base.cpp    | 8 ++++++++
 2 files changed, 13 insertions(+)

diff --git a/src/airconv/dxil/dxil_lower_resources.cpp b/src/airconv/dxil/dxil_lower_resources.cpp
index 6bd3661..d8fc762 100644
--- a/src/airconv/dxil/dxil_lower_resources.cpp
+++ b/src/airconv/dxil/dxil_lower_resources.cpp
@@ -379,6 +379,11 @@ Lowering::LowerTexture(uint32_t opcode, llvm::CallInst *call, const HandleInfo &
       ddx = ir.CreateInsertElement(ddx, one_d && i == 1 ? llvm::ConstantFP::get(ir.getFloatTy(), 0) : arg(10 + i), i);
       ddy = ir.CreateInsertElement(ddy, one_d && i == 1 ? llvm::ConstantFP::get(ir.getFloatTy(), 0) : arg(13 + i), i);
     }
+    // MacNeutron: D3D adds the sampler's MipLODBias to a gradient sample's LOD; Metal's gradient sample takes no bias.
+    // Gradients scaled by 2^bias move the LOD by bias, also past the anisotropy cap.
+    auto scale = ir.CreateVectorSplat(dims, air.CreateFPUnOp(llvm::air::AIRBuilder::exp2, bias, false));
+    ddx = ir.CreateFMul(ddx, scale);
+    ddy = ir.CreateFMul(ddy, scale);
     return result(air.CreateSampleGrad(tex, d->ResourceHandle, sampler, coord, array, ddx, ddy, min_lod(arg(16)).lod, o).first);
   }
   case op::SampleCmp: // (64, ..., compare, clamp)
diff --git a/src/airconv/nt/dxbc_converter_base.cpp b/src/airconv/nt/dxbc_converter_base.cpp
index 58a101c..f4bb770 100644
--- a/src/airconv/nt/dxbc_converter_base.cpp
+++ b/src/airconv/nt/dxbc_converter_base.cpp
@@ -1822,6 +1822,14 @@ Converter::operator()(const InstSampleDerivative &sample) {
     return;
   }
 
+  // MacNeutron: D3D adds the sampler's MipLODBias to sample_d's LOD; Metal's gradient sample takes no bias. Gradients
+  // scaled by 2^bias move the LOD by bias, also past the anisotropy cap.
+  auto Scale = ir.CreateVectorSplat(
+      llvm::cast<llvm::FixedVectorType>(DDX->getType())->getNumElements(), air.CreateFPUnOp(AIRBuilder::exp2, Sampler->Bias, false)
+  );
+  DDX = ir.CreateFMul(DDX, Scale);
+  DDY = ir.CreateFMul(DDY, Scale);
+
   auto [Value, Residency] = air.CreateSampleGrad(
       Tex->Texture, Tex->Handle, SamplerHandle, Coord, ArrayIndex, DDX, DDY, MinLODClamp, sample.offsets
   );

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Wed, 7 Oct 2026 00:12:28 -0400
Subject: [PATCH] airconv: Fuse DXIL FMad unless the result is precise.

dx.op.FMad was always lowered to a separate multiply and add, so a
mad() cost two instructions and two roundings. DXC marks the FMads that
must not fuse (precise results) with !dx.precise; the others now lower
to air.fma, as Metal Shader Converter does for exactly the same ones.
In SMITE 2's shaders that is 155,555 of 227,126 FMads (2-2.5 % of ALU).

Pre-raster stages fuse them too: the fma is explicit, so a depth
prepass and a base pass lowered from the same DXIL still compute the
same positions.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/airconv/dxil/dxil_converter.cpp  | 2 ++
 src/airconv/dxil/dxil_lower_math.cpp | 5 ++++-
 2 files changed, 6 insertions(+), 1 deletion(-)

diff --git a/src/airconv/dxil/dxil_converter.cpp b/src/airconv/dxil/dxil_converter.cpp
index f9c7ae1..1910442 100644
--- a/src/airconv/dxil/dxil_converter.cpp
+++ b/src/airconv/dxil/dxil_converter.cpp
@@ -236,6 +236,8 @@ LowerBody(const DXILShader &dxil, struct context &ctx, llvm::Function *dxil_main
   // fast flag at all (Metal's compiler treats any as leave to ignore NaN: (x < y) || (x >= y) came out true for a NaN).
   // As airconv's DXBC path (Converter::UseFastMath), pre-raster stages neither reassociate, fuse nor use reciprocals,
   // so a depth prepass and a base pass compute the same positions (their depth EQUAL test holds). (MacNeutron)
+  // A non-precise FMad still becomes air.fma there (Lowering): an explicit fma is the same in every shader the same
+  // DXIL is lowered into, whatever Metal's compiler would contract.
   bool pre_raster = dxil.entry.kind == ShaderKind::Vertex || dxil.entry.kind == ShaderKind::Geometry ||
                     dxil.entry.kind == ShaderKind::Hull || dxil.entry.kind == ShaderKind::Domain;
   for (auto *bb : blocks) {
diff --git a/src/airconv/dxil/dxil_lower_math.cpp b/src/airconv/dxil/dxil_lower_math.cpp
index 53e515b..8745644 100644
--- a/src/airconv/dxil/dxil_lower_math.cpp
+++ b/src/airconv/dxil/dxil_lower_math.cpp
@@ -117,7 +117,10 @@ Lowering::LowerMath(uint32_t opcode, llvm::CallInst *call) {
                                ir.CreateZExtOrTrunc(ir.CreateExtractValue(r, {1}), ty->getStructElementType(1))}));
   }
 
-  case op::FMad: return done(ir.CreateFAdd(ir.CreateFMul(arg(1), arg(2)), arg(3))); // not fused, like D3D's mad
+  case op::FMad: // fused unless precise (DXC marks those; Metal Shader Converter fuses the same ones). (MacNeutron)
+    if (!call->getMetadata("dx.precise"))
+      return done(air.CreateFMA(arg(1), arg(2), arg(3)));
+    return done(ir.CreateFAdd(ir.CreateFMul(arg(1), arg(2)), arg(3)));
   case op::Fma: return done(air.CreateFMA(arg(1), arg(2), arg(3)));
   case op::IMad:
   case op::UMad: return done(ir.CreateAdd(ir.CreateMul(arg(1), arg(2)), arg(3)));

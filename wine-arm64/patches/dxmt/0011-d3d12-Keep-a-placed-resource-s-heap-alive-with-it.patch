From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Tue, 6 Oct 2026 20:21:42 -0400
Subject: [PATCH] d3d12: Keep a placed resource's heap alive with it.

A texture or buffer placed in a heap holds a private reference on the
heap, as D3D12's placed resources do: an app that releases its heap
while resources placed in it live no longer destroys it, so the heap
stays in the device's residency set until its last resource goes. The
public reference count is unchanged (Release still returns 0, as on
D3DMetal). DXMT_STATS counts "heaps destroyed".

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d12/d3d12_buffer.cpp  | 7 +++++--
 src/d3d12/d3d12_device.hpp  | 3 +++
 src/d3d12/d3d12_heap.cpp    | 1 +
 src/d3d12/d3d12_texture.cpp | 2 ++
 4 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/src/d3d12/d3d12_buffer.cpp b/src/d3d12/d3d12_buffer.cpp
index 679b849..49d6886 100644
--- a/src/d3d12/d3d12_buffer.cpp
+++ b/src/d3d12/d3d12_buffer.cpp
@@ -28,6 +28,7 @@ class MTLD3D12Buffer : public MTLD3D12Pageable<MTLD3D12Resource> {
   D3D12_RESOURCE_DESC desc_;
   D3D12_HEAP_PROPERTIES heap_props_;
   D3D12_HEAP_FLAGS heap_flags_;
+  Com<MTLD3D12Heap, false> heap_; // MacNeutron: a placed buffer keeps its heap (and its residency), as in D3D12
 
 public:
   MTLD3D12Buffer(MTLD3D12Device *pDevice) : MTLD3D12Pageable<MTLD3D12Resource>(pDevice) {}
@@ -63,10 +64,12 @@ public:
     Flags<BufferAllocationFlag> flags;
     if (pHeap && IsPrivateHeap(&heap_props_)) // committed buffers stay Shared
       flags.set(BufferAllocationFlag::CpuInvisible);
-    if (pHeap)
+    if (pHeap) {
       buffer->rename(buffer->allocate(flags, pHeap->heap, Offset));
-    else
+      heap_ = pHeap;
+    } else {
       buffer->rename(buffer->allocate(flags));
+    }
     device_->RegisterResidencyAndVA(buffer->current());
 
     return S_OK;
diff --git a/src/d3d12/d3d12_device.hpp b/src/d3d12/d3d12_device.hpp
index bffd2d1..201d0f8 100644
--- a/src/d3d12/d3d12_device.hpp
+++ b/src/d3d12/d3d12_device.hpp
@@ -120,6 +120,9 @@ public:
 class MTLD3D12Heap : public ID3D12Heap {
 public:
   WMT::Reference<WMT::Heap> heap;
+
+  virtual void AddRefPrivate() = 0;
+  virtual void ReleasePrivate() = 0;
 };
 
 class MTLD3D12Fence : public ID3D12Fence1 {
diff --git a/src/d3d12/d3d12_heap.cpp b/src/d3d12/d3d12_heap.cpp
index b5bd78b..0c7b4c4 100644
--- a/src/d3d12/d3d12_heap.cpp
+++ b/src/d3d12/d3d12_heap.cpp
@@ -31,6 +31,7 @@ public:
   MTLD3D12HeapImpl(MTLD3D12Device *pDevice) : MTLD3D12Pageable<MTLD3D12Heap>(pDevice) {}
 
   ~MTLD3D12HeapImpl() {
+    DXMT_STAT_COUNT("#heaps destroyed", 1);
     if (heap)
       device_->UnregisterResidency(heap);
     heap = {};
diff --git a/src/d3d12/d3d12_texture.cpp b/src/d3d12/d3d12_texture.cpp
index c123dfd..dd1c85a 100644
--- a/src/d3d12/d3d12_texture.cpp
+++ b/src/d3d12/d3d12_texture.cpp
@@ -187,6 +187,7 @@ class MTLD3D12Texture : public MTLD3D12Pageable<MTLD3D12Resource> {
   D3D12_RESOURCE_DESC desc_;
   D3D12_HEAP_PROPERTIES heap_props_;
   D3D12_HEAP_FLAGS heap_flags_;
+  Com<MTLD3D12Heap, false> heap_; // MacNeutron: a placed texture keeps its heap (and its residency), as in D3D12
 
 public:
   MTLD3D12Texture(MTLD3D12Device *pDevice) : MTLD3D12Pageable<MTLD3D12Resource>(pDevice) {}
@@ -238,6 +239,7 @@ public:
       flags.set(TextureAllocationFlag::CpuInvisible);
     if (pHeap) {
       texture->rename(texture->allocate(flags, pHeap->heap, HeapOffset));
+      heap_ = pHeap;
     } else {
       texture->rename(texture->allocate(flags));
       device_->RegisterResidency(texture->current()->texture());
-- 

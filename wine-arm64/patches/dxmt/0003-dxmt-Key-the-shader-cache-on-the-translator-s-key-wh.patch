From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Mon, 5 Oct 2026 18:29:20 -0400
Subject: [PATCH] dxmt: Key the shader cache on the translator's key when
 given.

ShaderCacheVersion() hashed DXMT_VERSION, `git describe --always` of the
tree, so the translation cache followed git, not the translator:

- MacNeutron applies its DXMT patches with git am, so every re-fetch of
  an unchanged series makes new commits and a new version: every
  translated function misses (SMITE 2: about 20,000) and the launcher's
  stamp forces a replay before the game.
- An uncommitted edit to airconv keeps the old version, so a development
  build serves translations from the previous airconv.

A new option, translator_key_file, names a file holding the
translator's key, which MacNeutron's build computes from what changes
translated output (airconv, the DXBC parser, the headers, the flags,
LLVM and the compilers). meson reads it with fs.read, so a new key
regenerates dxmt_translator_key.h without new setup options, and
ShaderCacheVersion() hashes it in DXMT_VERSION's place. Without the
option the header's key is empty and the cache is keyed as before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 meson.options                  | 3 ++-
 src/dxmt/dxmt_shader_cache.cpp | 5 ++++-
 src/dxmt/meson.build           | 7 +++++++
 3 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/meson.options b/meson.options
index 715b176..dc84a45 100644
--- a/meson.options
+++ b/meson.options
@@ -8,4 +8,5 @@ option('wine_builtin_dll', type : 'boolean', value : true)
 option('enable_tests', type : 'boolean', value : false)
 option('enable_nvapi', type : 'boolean', value : false)
 option('enable_nvngx', type : 'boolean', value : false)
-option('enable_d3d12', type : 'boolean', value : false)
\ No newline at end of file
+option('enable_d3d12', type : 'boolean', value : false)
+option('translator_key_file', type : 'string', value : '', description : 'A file holding the shader translator\'s key; empty: DXMT\'s version keys the shader cache')
diff --git a/src/dxmt/dxmt_shader_cache.cpp b/src/dxmt/dxmt_shader_cache.cpp
index 81c93a5..767afcc 100644
--- a/src/dxmt/dxmt_shader_cache.cpp
+++ b/src/dxmt/dxmt_shader_cache.cpp
@@ -2,13 +2,16 @@
 #include "util_env.hpp"
 #include "util_string.hpp"
 #include <version.h>
+#include "dxmt_translator_key.h"
 
 namespace dxmt {
 
+// MacNeutron: keyed on the translator's key when the build has one (a hash of what changes translated output), so a
+// re-fetch of the same patches, or a change outside the translator, keeps the cache; otherwise on DXMT's git version.
 uint64_t
 ShaderCacheVersion() {
   uint64_t hash = 0xcbf29ce484222325ull; // FNV-1a
-  for (const char *p = DXMT_VERSION; *p; p++)
+  for (const char *p = DXMT_TRANSLATOR_KEY[0] ? DXMT_TRANSLATOR_KEY : DXMT_VERSION; *p; p++)
     hash = (hash ^ (uint8_t)*p) * 0x100000001b3ull;
   for (int i = 0; i < 4; i++)
     hash = (hash ^ (uint8_t)((uint32_t)AIRCONV_VERSION >> (8 * i))) * 0x100000001b3ull;
diff --git a/src/dxmt/meson.build b/src/dxmt/meson.build
index 9d5bfe2..0713297 100644
--- a/src/dxmt/meson.build
+++ b/src/dxmt/meson.build
@@ -35,6 +35,13 @@ dxmt_shaders_lib = metallib_generator.process(dxmt_shaders_ir)
 
 dxmt_shaders_header = hexdump_generator.process(dxmt_shaders_lib)
 
+# MacNeutron: the shader translator's key (wine-arm64/build.sh) keys the shader cache when given. Read from a file, so
+# a new key regenerates the header (fs.read makes the file a regeneration dependency) without new setup options.
+translator_key_file = get_option('translator_key_file')
+translator_conf = configuration_data()
+translator_conf.set_quoted('DXMT_TRANSLATOR_KEY', translator_key_file == '' ? '' : fs.read(translator_key_file).strip())
+configure_file(output : 'dxmt_translator_key.h', configuration : translator_conf)
+
 dxmt_lib = static_library('dxmt', dxmt_src, dxmt_shaders_header, dxmt_version,
   dependencies        : [ util_dep, airconv_forward_dep, winemetal_dep ],
   include_directories : [ dxmt_include_path ],
-- 
2.54.0 (Apple Git-157)


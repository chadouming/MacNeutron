From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Wed, 7 Oct 2026 10:31:59 -0400
Subject: [PATCH] airconv: Fence device memory for synced barriers at Metal
 3.1.

DeviceMemoryBarrierWithGroupSync and AllMemoryBarrierWithGroupSync emitted
their air.atomic.fence only at Metal 3.2, and D3D12 compiles at 3.1: the
air.wg.barrier that remained orders memory within the group only, so a
group could read another group's stale results after it (a last-group
reduction). Fence at the barrier's scope at any version, then wait for the
group, as Metal Shader Converter does at 3.1.

DXBC's sync had the same gate, and a TGSM fence without the group sync
(GroupMemoryBarrier) emitted nothing at any version: a fence alone now.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/airconv/dxil/dxil_lower.cpp        | 13 +++++++------
 src/airconv/nt/dxbc_converter_base.hpp | 26 ++++++++++++++------------
 2 files changed, 21 insertions(+), 18 deletions(-)

diff --git a/src/airconv/dxil/dxil_lower.cpp b/src/airconv/dxil/dxil_lower.cpp
index 795f6e5..7751753 100644
--- a/src/airconv/dxil/dxil_lower.cpp
+++ b/src/airconv/dxil/dxil_lower.cpp
@@ -462,10 +462,12 @@ Lowering::LowerOther(uint32_t opcode, llvm::CallInst *call) {
     return llvm::Error::success();
   }
   case op::Barrier: { // (80, i32 mode): 1 = sync threadgroup, 2 = UAV fence global, 4 = UAV fence threadgroup, 8 = TGSM fence
-    // As airconv's DXBC sync lowering (nt/dxbc_converter_base.hpp, InstSync). A fence without the sync bit
-    // (GroupMemoryBarrier 8, AllMemoryBarrier 10, DeviceMemoryBarrier 2) orders memory but doesn't wait for the group:
-    // a fence alone, at any Metal version (Metal Shader Converter emits air.atomic.fence for them at Metal 3.1 too); it
-    // used to emit nothing below 3.2. (MacNeutron)
+    // As airconv's DXBC sync lowering (nt/dxbc_converter_base.hpp, InstSync), at any Metal version, as Metal Shader
+    // Converter does at Metal 3.1: a fence without the sync bit (GroupMemoryBarrier 8, AllMemoryBarrier 10,
+    // DeviceMemoryBarrier 2) orders memory but doesn't wait for the group, so a fence alone; a synced UAV barrier
+    // (DeviceMemoryBarrierWithGroupSync 3, AllMemoryBarrierWithGroupSync 11) a fence at its scope, then the barrier,
+    // whose memory flags order only within the group. Both used to fence only at 3.2, and D3D12 compiles at 3.1.
+    // (MacNeutron)
     using namespace llvm::air;
     uint32_t mode = ConstantU32(call->getArgOperand(1));
     bool sync = mode & 1, non_execution = ctx.metal_version >= SM50_SHADER_METAL_320;
@@ -477,8 +479,7 @@ Lowering::LowerOther(uint32_t opcode, llvm::CallInst *call) {
       if (flags != MemFlags::None)
         air.CreateAtomicFence(flags, scope);
     } else if (mode & 6) {
-      if (non_execution)
-        air.CreateAtomicFence(flags, scope);
+      air.CreateAtomicFence(flags, scope);
       air.CreateBarrier(non_execution ? MemFlags::None : flags);
     } else {
       air.CreateBarrier(flags);
diff --git a/src/airconv/nt/dxbc_converter_base.hpp b/src/airconv/nt/dxbc_converter_base.hpp
index c600d3d..945e1d7 100644
--- a/src/airconv/nt/dxbc_converter_base.hpp
+++ b/src/airconv/nt/dxbc_converter_base.hpp
@@ -240,23 +240,25 @@ public:
     air.CreateDiscard();
   }
 
+  // MacNeutron: a UAV sync fences at its scope at any Metal version, then waits for the group if asked (a barrier's
+  // memory flags order only within the group); a TGSM fence without the group sync (GroupMemoryBarrier) is a fence
+  // alone. Both used to fence only at Metal 3.2, and the TGSM one emitted nothing. dxil_lower.cpp's Barrier does the
+  // same for DXIL.
   void
   operator()(const InstSync &sync) {
     using namespace llvm::air;
     MemFlags mem_flag = sync.tgsm_memory_barrier ? MemFlags::Threadgroup : MemFlags::None;
-    if (sync.uav_boundary != InstSync::UAVBoundary::none) {
+    bool uav = sync.uav_boundary != InstSync::UAVBoundary::none;
+    if (uav)
       mem_flag |= MemFlags::Device | MemFlags::Texture;
-      if (SupportsNonExecutionBarrier())
-        air.CreateAtomicFence(
-            mem_flag,
-            (sync.uav_boundary == InstSync::UAVBoundary::global ? (ThreadScope::Device | ThreadScope::Threadgroup)
-                                                                : ThreadScope::Threadgroup)
-        );
-      if (sync.tgsm_execution_barrier)
-        air.CreateBarrier(SupportsNonExecutionBarrier() ? MemFlags::None : mem_flag);
-    } else if (sync.tgsm_execution_barrier) {
-      air.CreateBarrier(mem_flag);
-    }
+    if (uav || (!sync.tgsm_execution_barrier && mem_flag != MemFlags::None))
+      air.CreateAtomicFence(
+          mem_flag,
+          (sync.uav_boundary == InstSync::UAVBoundary::global ? (ThreadScope::Device | ThreadScope::Threadgroup)
+                                                              : ThreadScope::Threadgroup)
+      );
+    if (sync.tgsm_execution_barrier)
+      air.CreateBarrier(uav && SupportsNonExecutionBarrier() ? MemFlags::None : mem_flag);
   }
 
   void operator()(const InstMov &);
-- 

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Wed, 7 Oct 2026 00:13:25 -0400
Subject: [PATCH] airconv: Add DXMT_DXIL_BOUNDS=off to measure the cost of
 bounds checks.

Typed Buffer<> reads compare their index with the view's element count
and raw and structured accesses check their offset against the view's
length: an int compare and a select per access, 28 % more ALU in
SMITE 2's vertex shaders than Metal Shader Converter's.

DXMT_DXIL_BOUNDS=off drops those checks (the view's offset is still
added), so a game run can measure what they cost. It is for measuring
only: an access past its view reads or writes whatever lies there. The
shader cache already keys any DXMT_DXIL_BOUNDS value apart.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/airconv/dxil/dxil_lower.cpp           |  5 +++++
 src/airconv/dxil/dxil_lower.hpp           |  4 ++++
 src/airconv/dxil/dxil_lower_resources.cpp | 10 ++++++----
 src/d3d12/d3d12_shader_cache.cpp          |  3 ++-
 4 files changed, 17 insertions(+), 5 deletions(-)

diff --git a/src/airconv/dxil/dxil_lower.cpp b/src/airconv/dxil/dxil_lower.cpp
index f84c257..795f6e5 100644
--- a/src/airconv/dxil/dxil_lower.cpp
+++ b/src/airconv/dxil/dxil_lower.cpp
@@ -76,6 +76,11 @@ DxilBoundsPerComponent() {
   static const bool on = Switch("DXMT_DXIL_BOUNDS", "component");
   return on;
 }
+bool
+DxilBoundsOff() {
+  static const bool on = Switch("DXMT_DXIL_BOUNDS", "off");
+  return on;
+}
 
 Lowering::Lowering(const DXILShader &dxil, dxbc::context &ctx, const EntryInfo *vertex_outputs) :
     dxil(dxil),
diff --git a/src/airconv/dxil/dxil_lower.hpp b/src/airconv/dxil/dxil_lower.hpp
index caf76f4..5e95ae8 100644
--- a/src/airconv/dxil/dxil_lower.hpp
+++ b/src/airconv/dxil/dxil_lower.hpp
@@ -38,6 +38,10 @@ llvm::Expected<HandleInfo> ResolveHandle(const EntryInfo &entry, llvm::Value *ha
 // (Metal Shader Converter's form: one that straddles its view's end reads zeros); DXMT_DXIL_BOUNDS=component checks
 // each component, as before (triage).
 bool DxilBoundsPerComponent();
+// DXMT_DXIL_BOUNDS=off (Task F2, measurement only): no bounds checks on typed Buffer<> reads (the view's offset is
+// still added) nor on raw and structured accesses: a read past a view reads whatever lies there (a GPU fault where
+// nothing is mapped), a write past it lands there.
+bool DxilBoundsOff();
 
 class Lowering {
 public:
diff --git a/src/airconv/dxil/dxil_lower_resources.cpp b/src/airconv/dxil/dxil_lower_resources.cpp
index cff6006..6bd3661 100644
--- a/src/airconv/dxil/dxil_lower_resources.cpp
+++ b/src/airconv/dxil/dxil_lower_resources.cpp
@@ -44,7 +44,7 @@ Lowering::ElementPointer(dxbc::BufferResourceHandle &buffer, llvm::Value *byte_o
   unsigned space = llvm::cast<llvm::PointerType>(buffer.Pointer->getType())->getAddressSpace();
   auto bytes = ir.CreateBitCast(buffer.Pointer, ir.getInt8PtrTy(space));
   auto ptr = ir.CreateBitCast(ir.CreateGEP(ir.getInt8Ty(), bytes, byte_offset), ty->getPointerTo(space));
-  if (!buffer.Metadata)
+  if (!buffer.Metadata || DxilBoundsOff())
     return ptr;
   return ir.CreateSelect(InBounds(buffer, byte_offset, ty->getPrimitiveSizeInBits() / 8), ptr,
                          llvm::Constant::getNullValue(ptr->getType()));
@@ -65,7 +65,7 @@ Lowering::AccessPointer(dxbc::BufferResourceHandle &buffer, llvm::Value *byte_of
   unsigned space = llvm::cast<llvm::PointerType>(buffer.Pointer->getType())->getAddressSpace();
   auto bytes = ir.CreateBitCast(buffer.Pointer, ir.getInt8PtrTy(space));
   auto ptr = ir.CreateBitCast(ir.CreateGEP(ir.getInt8Ty(), bytes, byte_offset), ty->getPointerTo(space));
-  if (!buffer.Metadata)
+  if (!buffer.Metadata || DxilBoundsOff())
     return ptr;
   return ir.CreateSelect(InBounds(buffer, byte_offset, count * (ty->getPrimitiveSizeInBits() / 8)), ptr,
                          llvm::Constant::getNullValue(ptr->getType()));
@@ -157,9 +157,11 @@ Lowering::LowerTypedBufferLoad(llvm::CallInst *call, const HandleInfo &h, llvm::
   tex.kind = d->ResourceKind;
   tex.sample_type = d->SampleType;
   tex.memory_access = d->MemoryAccess;
-  auto oob = ir.CreateICmpUGE(index, conv.DecodeTextureBufferElement(d->Metadata));
   auto address = ir.CreateAdd(index, conv.DecodeTextureBufferOffset(d->Metadata));
-  address = ir.CreateSelect(oob, llvm::ConstantInt::getAllOnesValue(address->getType()), address);
+  if (!DxilBoundsOff()) {
+    auto oob = ir.CreateICmpUGE(index, conv.DecodeTextureBufferElement(d->Metadata));
+    address = ir.CreateSelect(oob, llvm::ConstantInt::getAllOnesValue(address->getType()), address);
+  }
   if (tex.memory_access == llvm::air::Texture::acesss_readwrite) // as the DXBC typed UAV load: see earlier writes
     air.CreateTextureFence(tex, d->ResourceHandle);
   auto [texel, residency] = air.CreateRead(tex, d->ResourceHandle, address, nullptr, nullptr, ir.getInt32(0), d->GlobalCoherent);
diff --git a/src/d3d12/d3d12_shader_cache.cpp b/src/d3d12/d3d12_shader_cache.cpp
index c000c3e..bd6f97b 100644
--- a/src/d3d12/d3d12_shader_cache.cpp
+++ b/src/d3d12/d3d12_shader_cache.cpp
@@ -182,7 +182,8 @@ CompileFunction(WMT::Device device, FunctionKind kind, CachedShader &first, Cach
     if (second)
       shaders.update(second->digest());
     v.update(Tag("d3d12-function")).update(name, strlen(name)).update(*variant);
-    // DXMT_DXIL_BOUNDS=component (GPU efficiency spec E5) translates differently: it keys its own entries.
+    // DXMT_DXIL_BOUNDS=component (GPU efficiency spec E5) and =off (Task F2) translate differently: any value keys its
+    // own entries.
     static const std::string bounds = env::getEnvVar("DXMT_DXIL_BOUNDS");
     if (!bounds.empty())
       v.update(bounds.data(), bounds.size());
-- 

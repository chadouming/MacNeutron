From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chad Cormier Roussel <chadcormierroussel@gmail.com>
Date: Sat, 3 Oct 2026 17:51:24 -0400
Subject: [PATCH] d3d12: Read the ARM64 counter on arm64 builds.

An ARM64X build (build-arm64ec.txt, -Denable_d3d12=true) stops at this
file, the only one in DXMT that doesn't compile for arm64:

  ia32intrin.h:312:10: error: use of undeclared identifier
  '__builtin_ia32_readeflags_u32'

and the same for every other x86 builtin <x86intrin.h> declares, since
the file includes it and calls __rdtsc unconditionally. Read the counter
through one function instead: __rdtsc on x86, cntvct_el0 (readable from
EL0 on macOS) on ARM64 and ARM64EC, using util_bit.hpp's DXMT_ARCH_*,
which the file now includes. Report() already calibrates the counter
against QueryPerformanceCounter, so the rate doesn't matter. The x86
build compiles as before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d12/d3d12_stats.cpp | 23 +++++++++++++++++++----
 1 file changed, 19 insertions(+), 4 deletions(-)

diff --git a/src/d3d12/d3d12_stats.cpp b/src/d3d12/d3d12_stats.cpp
index d2f7e38..d02cad4 100644
--- a/src/d3d12/d3d12_stats.cpp
+++ b/src/d3d12/d3d12_stats.cpp
@@ -1,9 +1,12 @@
 #include "d3d12_stats.hpp"
+#include "util_bit.hpp"
 #include "d3d12_dxil_dump.hpp"
 #include "util_env.hpp"
 #include "util_string.hpp"
 #include <windows.h>
+#if defined(DXMT_ARCH_X86)
 #include <x86intrin.h>
+#endif
 #include <algorithm>
 #include <atomic>
 #include <cstdio>
@@ -21,6 +24,18 @@ namespace {
 
 constexpr unsigned kMaxStats = 1024; // names past this share the last slot
 
+// The CPU's counter. Report() calibrates it against QueryPerformanceCounter, so its rate doesn't matter.
+inline uint64_t
+read_counter() {
+#if defined(DXMT_ARCH_X86)
+  return __rdtsc();
+#elif defined(DXMT_ARCH_ARM64)
+  return __builtin_arm_rsr64("cntvct_el0");
+#else
+#error "no counter for this architecture"
+#endif
+}
+
 // One per thread that calls into D3D12; written only by its thread, read racily by the reporter (stats only).
 struct ThreadStats {
   DWORD tid;
@@ -68,7 +83,7 @@ Report(const char *why) {
   LARGE_INTEGER qpc, freq;
   QueryPerformanceCounter(&qpc);
   QueryPerformanceFrequency(&freq);
-  uint64_t tsc = __rdtsc();
+  uint64_t tsc = read_counter();
   double seconds = double(qpc.QuadPart - g_last_qpc.QuadPart) / freq.QuadPart;
   double per_us = seconds > 0 ? (tsc - g_last_tsc) / (seconds * 1e6) : 1;
   uint64_t frames = g_frames - g_prev_frames;
@@ -157,7 +172,7 @@ struct Lifetime {
       return;
     DXILCaptureMode();
     QueryPerformanceCounter(&g_last_qpc);
-    g_last_tsc = __rdtsc();
+    g_last_tsc = read_counter();
   }
   ~Lifetime() {
     if (g_stats_on)
@@ -182,12 +197,12 @@ StatCount(unsigned id, uint64_t n) {
 uint64_t
 StatBegin() {
   Mine().depth++;
-  return __rdtsc();
+  return read_counter();
 }
 
 void
 StatEnd(unsigned id, uint64_t t0) {
-  uint64_t d = __rdtsc() - t0;
+  uint64_t d = read_counter() - t0;
   auto &m = Mine();
   m.calls[id]++;
   m.ticks[id] += d;
-- 

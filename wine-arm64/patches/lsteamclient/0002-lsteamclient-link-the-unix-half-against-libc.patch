Subject: [PATCH] lsteamclient: link the unix half against libc++

From dappermint/winecx dada36ebab
---
 lsteamclient/Makefile.in | 1 +
 1 file changed, 1 insertion(+)

diff --git a/lsteamclient/Makefile.in b/lsteamclient/Makefile.in
index 516f755..190447c 100644
--- a/lsteamclient/Makefile.in
+++ b/lsteamclient/Makefile.in
@@ -3,6 +3,7 @@ UNIXLIB   = lsteamclient.so
 IMPORTS   = user32 ws2_32
 
 EXTRADEFS = -DSTEAM_API_EXPORTS -Dprivate=public -Dprotected=public -DNOMINMAX
+UNIX_LIBS = -lc++
 
 SOURCES = \
 	steam_input_manual.c \
